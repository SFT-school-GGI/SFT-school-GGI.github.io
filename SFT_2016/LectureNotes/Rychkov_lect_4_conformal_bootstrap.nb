           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "}"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"AspectRatio", "\[Rule]", " ", "1"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Joined", "\[Rule]", " ", "True"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"InterpolationOrder", "\[Rule]", " ", "4"}]}], 
