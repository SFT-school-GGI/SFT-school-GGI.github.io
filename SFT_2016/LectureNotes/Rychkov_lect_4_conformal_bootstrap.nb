Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"k", "[", 
    RowBox[{"\[Beta]_", ",", "z_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"k", "[", 
     RowBox[{"\[Beta]", ",", "z"}], "]"}], "=", 
    RowBox[{
     SuperscriptBox["z", 
      RowBox[{"\[Beta]", "/", "2"}]], 
     RowBox[{"Hypergeometric2F1", "[", 
      RowBox[{
       RowBox[{"\[Beta]", "/", "2"}], ",", 
       RowBox[{"\[Beta]", "/", "2"}], ",", "\[Beta]", ",", "z"}], "]"}]}]}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"g", "[", 
     RowBox[{"\[CapitalDelta]_", ",", "L_"}], "]"}], "[", 
    RowBox[{"z_", ",", "zb_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"k", "[", 
      RowBox[{
       RowBox[{"\[CapitalDelta]", "+", "L"}], ",", "z"}], "]"}], 
     RowBox[{"k", "[", 
      RowBox[{
       RowBox[{"\[CapitalDelta]", "-", "L"}], ",", "zb"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"k", "[", 
      RowBox[{
       RowBox[{"\[CapitalDelta]", "+", "L"}], ",", "zb"}], "]"}], 
     RowBox[{"k", "[", 
      RowBox[{
       RowBox[{"\[CapitalDelta]", "-", "L"}], ",", "z"}], "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"H", "[", 
     RowBox[{"\[CapitalDelta]\[Phi]_", ",", "\[CapitalDelta]_", ",", "L_"}], 
     "]"}], "[", 
    RowBox[{"z_", ",", "zb_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"z", " ", "zb"}], ")"}], "\[CapitalDelta]\[Phi]"], "-", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "z"}], ")"}], 
         RowBox[{"(", 
          RowBox[{"1", "-", "zb"}], ")"}]}], ")"}], 
       "\[CapitalDelta]\[Phi]"]}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", "z"}], ")"}], 
          RowBox[{"(", 
           RowBox[{"1", "-", "zb"}], ")"}]}], ")"}], "\[CapitalDelta]\[Phi]"], 
       RowBox[{
        RowBox[{"g", "[", 
         RowBox[{"\[CapitalDelta]", ",", "L"}], "]"}], "[", 
        RowBox[{"z", ",", "zb"}], "]"}]}], "-", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"z", " ", "zb"}], ")"}], "\[CapitalDelta]\[Phi]"], 
       RowBox[{
        RowBox[{"g", "[", 
         RowBox[{"\[CapitalDelta]", ",", "L"}], "]"}], "[", 
        RowBox[{
         RowBox[{"1", "-", "z"}], ",", 
         RowBox[{"1", "-", "zb"}]}], "]"}]}]}], ")"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.6646956765737877`*^9, 3.664695696742442*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"vector", "[", "h_", "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{"0.5", ",", "0.6"}], "]"}], "-", 
       RowBox[{"h", "[", 
        RowBox[{"0.5", ",", "0.333"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"h", "[", 
        RowBox[{"0.5", ",", "0.6"}], "]"}], "-", 
       RowBox[{"h", "[", 
        RowBox[{"0.333", ",", "0.25"}], "]"}]}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"normalizedVector", "[", 
    RowBox[{"\[CapitalDelta]\[Phi]_", ",", "\[CapitalDelta]_", ",", "L_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"v", "=", 
        RowBox[{"vector", "[", 
         RowBox[{"H", "[", 
          RowBox[{"\[CapitalDelta]\[Phi]", ",", "\[CapitalDelta]", ",", "L"}],
           "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"\[Lambda]", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"L", ">", "0"}], ",", 
          RowBox[{"1", "-", 
           RowBox[{"L", "/", "20"}]}], ",", 
          RowBox[{"1", "-", 
           RowBox[{"\[CapitalDelta]", "/", "20"}]}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"\[Lambda]", " ", 
      RowBox[{"v", "/", 
       RowBox[{"Norm", "[", "v", "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{3.664612366522629*^9}],

