     RowBox[{"\[CapitalDelta]\[Phi]", "=", "0.125"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Tau]min", "=", "0.01"}], ",", "\[IndentingNewLine]", 
     RowBox[{"\[Tau]max", "=", "4"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Lmax", "=", "14"}], ",", "\[IndentingNewLine]", 
     RowBox[{"\[CapitalDelta]scalarMin", "=", "0.1"}], " ", 
     StyleBox[
      RowBox[{"(*", " ", 
       RowBox[{
       "this", " ", "is", " ", "the", " ", "parameter", " ", "to", " ", 
        "vary", " ", "to", " ", "shave", " ", "off", " ", "parts", " ", "of", 
        " ", "the", " ", "scalar", " ", "curve"}], " ", "*)"}],
      FontSlant->"Italic",
      FontColor->RGBColor[1, 0, 0]], ",", "\[IndentingNewLine]", 
     "stressTensorVector", ",", "\[IndentingNewLine]", "blockVectors"}], 
    "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"stressTensorVector", "=", 
     RowBox[{"normalizedVector", "[", 
      RowBox[{"\[CapitalDelta]\[Phi]", ",", "2", ",", "2"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"blockVectors", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"normalizedVector", "[", 
        RowBox[{"\[CapitalDelta]\[Phi]", ",", 
         RowBox[{"\[Tau]", "+", "L"}], ",", "L"}], "]"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"L", ",", "0", ",", "Lmax", ",", "2"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"\[Tau]", ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"L", "==", "0"}], ",", "\[CapitalDelta]scalarMin", ",", 
           "\[Tau]min"}], "]"}], ",", "\[Tau]max", ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"L", "==", "0"}], ",", 
           RowBox[{"1", "/", "1000"}], ",", 
           RowBox[{"1", "/", "10"}]}], "]"}]}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"Show", "[", "\[IndentingNewLine]", 
